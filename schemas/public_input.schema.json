{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model-visible input whitelist",
  "type": "object",
  "required": [
    "schema_version",
    "input_id",
    "base_question_id",
    "question",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "input_id": {
      "type": "string",
      "minLength": 1
    },
    "base_question_id": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "text",
          "visible_metadata"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "visible_metadata": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "published_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reprint_of": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
